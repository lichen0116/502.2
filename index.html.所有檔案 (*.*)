            document.getElementById('aiModalTitle').innerHTML = `<i class="fa-solid fa-wand-magic-sparkles text-indigo-400"></i> AI 個人理財診斷`;
            document.getElementById('aiModalContent').innerHTML = `<div class="text-center py-6"><i class="fa-solid fa-spinner fa-spin text-2xl text-indigo-400"></i><p class="mt-2 text-slate-400">正在分析您的資產配置與風險分散程度...</p></div>`;
            document.getElementById('aiAudioContainer').classList.add('hidden');
            document.getElementById('aiModal').classList.remove('hidden');

            const prompt = `學生 ${currentUser.name} 當前資產為：現金 $${portfolio.cash}，持股為：${JSON.stringify(portfolio.shares)}。請提供 3 句精準親切的繁體中文理財建議與風險診斷，鼓勵其進行適當的分散投資。`;
            const advice = await callGeminiText(prompt, "你是一位國小/國中金融理財教育專家，用語親切有鼓勵性。");

            document.getElementById('aiModalContent').innerHTML = `<p class="whitespace-pre-line text-slate-200 font-medium">${advice}</p>`;
