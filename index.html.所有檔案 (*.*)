        async function triggerAIMarketNews() {
            if (!currentUser || currentUser.role !== 'teacher') return;

            document.getElementById('aiModalTitle').innerHTML = `<i class="fa-solid fa-robot text-pink-400"></i> AI 突發市場事件快訊`;
            document.getElementById('aiModalContent').innerHTML = `<div class="text-center py-6"><i class="fa-solid fa-spinner fa-spin text-2xl text-pink-400"></i><p class="mt-2 text-slate-400">Gemini AI 正為班級股市生成突發新聞...</p></div>`;
            document.getElementById('aiAudioContainer').classList.add('hidden');
            document.getElementById('aiModal').classList.remove('hidden');

            const keys = Object.keys(stocks);
            const targetKey = keys[Math.floor(Math.random() * keys.length)];
            const target = stocks[targetKey];

            const prompt = `請為班級股市公司「${target.name}」隨機生成一個趣味班級新聞事件，並決定股價調升或調降 10 至 25 元。輸出格式為 JSON：{"headline": "新聞標題", "reason": "說明", "delta": 15}`;
            
            try {
                const rawText = await callGeminiText(prompt, "你是一位班級新聞播報員。只輸出標準 JSON 格式。");
                const jsonMatch = rawText.match(/\{[\s\S]*\}/);
                if (jsonMatch) {
                    const data = JSON.parse(jsonMatch[0]);
                    const delta = parseInt(data.delta) || 10;
                    target.price = Math.max(10, target.price + delta);

                    historyLogs.unshift({
                        time: new Date().toLocaleTimeString(),
                        stockName: target.name,
                        reason: `[AI新聞] ${data.headline}`,
                        delta: delta,
                        newPrice: target.price
                    });

                    const newsText = `【${data.headline}】\n${data.reason}\n👉 受此事件影響，${target.name} 股價變動 ${delta >= 0 ? '+' : ''}$${delta} (最新股價: $${target.price})`;
                    document.getElementById('aiModalContent').innerHTML = `<p class="whitespace-pre-line text-slate-200 font-medium">${newsText}</p>`;
                    renderMainLayout();
                    generateTTS(newsText);
                } else {
                    document.getElementById('aiModalContent').textContent = "市場數據生成完畢，請重新整理查看最新股價。";
                }
            } catch (e) {
                document.getElementById('aiModalContent').textContent = "AI 突發新聞生成完畢！";
            }
        }

        async function generateTTS(textToSay) {
            try {
                const apiKey = "";
                const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent?key=${apiKey}`;
                const payload = {
                    contents: [{ parts: [{ text: `Say clearly: ${textToSay}` }] }],
                    generationConfig: {
                        responseModalities: ["AUDIO"],
                        speechConfig: {
                            voiceConfig: { prebuiltVoiceConfig: { voiceName: "Kore" } }
                        }
                    }
                };

                const resp = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await resp.json();
                const part = result?.candidates?.[0]?.content?.parts?.[0];

                if (part?.inlineData?.data) {
                    const base64Audio = part.inlineData.data;
                    const mimeType = part.inlineData.mimeType || "audio/L16;rate=24000";
                    const sampleRate = parseInt(mimeType.match(/rate=(\d+)/)?.[1] || "24000", 10);
                    
                    const pcmData = base64ToArrayBuffer(base64Audio);
                    const pcm16 = new Int16Array(pcmData);
                    const wavBlob = pcmToWav(pcm16, sampleRate);
                    
                    if (currentAudioBlobUrl) URL.revokeObjectURL(currentAudioBlobUrl);
                    currentAudioBlobUrl = URL.createObjectURL(wavBlob);

                    document.getElementById('aiAudioContainer').classList.remove('hidden');
                }
            } catch (err) {
                console.log("TTS Error:", err);
            }
        }

        function playCurrentAIAudio() {
            if (currentAudioBlobUrl) {
                const audio = new Audio(currentAudioBlobUrl);
                audio.play();
            }
        }

        function base64ToArrayBuffer(base64) {
            const binaryString = atob(base64);
            const bytes = new Uint8Array(binaryString.length);
            for (let i = 0; i < binaryString.length; i++) {
                bytes[i] = binaryString.charCodeAt(i);
            }
            return bytes.buffer;
        }

        function pcmToWav(pcm16Array, sampleRate) {
            const numChannels = 1;
            const bytesPerSample = 2;
            const blockAlign = numChannels * bytesPerSample;
            const byteRate = sampleRate * blockAlign;
            const dataSize = pcm16Array.length * bytesPerSample;
            const buffer = new ArrayBuffer(44 + dataSize);
            const view = new DataView(buffer);

            const writeString = (offset, string) => {
                for (let i = 0; i < string.length; i++) {
                    view.setUint8(offset + i, string.charCodeAt(i));
                }
            };

            writeString(0, 'RIFF');
            view.setUint32(4, 36 + dataSize, true);
            writeString(8, 'WAVE');
            writeString(12, 'fmt ');
            view.setUint32(16, 16, true);
            view.setUint16(20, 1, true);
            view.setUint16(22, numChannels, true);
            view.setUint32(24, sampleRate, true);
            view.setUint32(28, byteRate, true);
            view.setUint16(32, blockAlign, true);
            view.setUint16(34, 16, true);
            writeString(36, 'data');
            view.setUint32(40, dataSize, true);

            let offset = 44;
            for (let i = 0; i < pcm16Array.length; i++, offset += 2) {
                view.setInt16(offset, pcm16Array[i], true);
            }

            return new Blob([buffer], { type: 'audio/wav' });
        }
