        function renderPersonalAssets() {
            if (!currentUser || currentUser.role !== 'student') return;
            const portfolio = studentPortfolios[currentUser.id];
            
            // Calculate Stock Value
            let stockVal = 0;
            Object.keys(stocks).forEach(g => {
                stockVal += (portfolio.shares[g] || 0) * stocks[g].price;
            });
            const totalNetWorth = portfolio.cash + stockVal;

            document.getElementById('netWorthDisplay').innerHTML = `$${totalNetWorth.toLocaleString()} <span class="text-sm font-normal text-slate-400">班幣</span>`;
            document.getElementById('cashDisplay').textContent = `$${portfolio.cash.toLocaleString()}`;
            document.getElementById('stockValueDisplay').textContent = `$${stockVal.toLocaleString()}`;

            renderAssetChart(portfolio.cash, portfolio.shares);

            const holdingsList = document.getElementById('holdingsList');
            holdingsList.innerHTML = '';

            Object.keys(stocks).forEach(gKey => {
                const count = portfolio.shares[gKey] || 0;
                if (count > 0) {
                    const st = stocks[gKey];
                    const val = count * st.price;
                    const isHome = (gKey === currentUser.homeGroup);

                    const div = document.createElement('div');
                    div.className = 'p-2 bg-slate-900/80 rounded-xl border border-slate-800 flex justify-between items-center';
