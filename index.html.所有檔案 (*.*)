                        <i class="fa-solid fa-chart-pie"></i> 公司 AI 研報分析
                    </button>
                `;
                container.appendChild(card);
            });
        }

        function buyStock(gKey) {
            if (!currentUser || currentUser.role !== 'student') return;

            if (!isMarketOpen) {
                showNotice(
                    '股市休市中',
                    '班導師目前已將股市關閉休市，暫時無法下單買進股票。請等待班導師開放交易！',
                    'fa-lock',
                    'text-rose-400',
                    'border-rose-500/30'
                );
                return;
            }

            const portfolio = studentPortfolios[currentUser.id];
            const price = stocks[gKey].price;

            if (portfolio.cash < price) {
                showNotice(
                    '現金餘額不足',
                    `您目前的現金金額為 $${portfolio.cash} 班幣，無法購買每股 $${price} 班幣的 ${stocks[gKey].name} 股票。請先賣出部分持股變現！`,
                    'fa-triangle-exclamation',
                    'text-rose-400',
                    'border-rose-500/30'
                );
                return;
            }

            portfolio.cash -= price;
            portfolio.shares[gKey] = (portfolio.shares[gKey] || 0) + 1;

            renderPersonalAssets();
            renderStocksGrid();
        }

        function sellStock(gKey) {
            if (!currentUser || currentUser.role !== 'student') return;

            if (!isMarketOpen) {
                showNotice(
                    '股市休市中',
                    '班導師目前已將股市關閉休市，暫時無法下單賣出股票。請等待班導師開放交易！',
                    'fa-lock',
                    'text-rose-400',
                    'border-rose-500/30'
                );
                return;
            }

            const portfolio = studentPortfolios[currentUser.id];
            const currentShares = portfolio.shares[gKey] || 0;

            // Check 1: User holds 0 shares of this stock
            if (currentShares <= 0) {
                showNotice(
                    '無法賣出股票',
                    `您目前未持有【${stocks[gKey].name}】的任何股份！請先透過下單中心買進該股票後方可執行賣出。`,
                    'fa-circle-xmark',
                    'text-rose-400',
                    'border-rose-500/30'
                );
                return;
            }

            // Check 2: Enforce minimum 12 shares retained rule for home company
            if (gKey === currentUser.homeGroup && currentShares <= 12) {
                showNotice(
                    '經營權保障規則限制',
                    `自家公司【${stocks[gKey].name}】最少必須保留 12 股作為經營權核心保障，目前持有 ${currentShares} 股已達賣出下限！`,
                    'fa-shield-halved',
                    'text-amber-400',
                    'border-amber-500/30'
                );
                return;
            }

            portfolio.cash += stocks[gKey].price;
            portfolio.shares[gKey] -= 1;

            renderPersonalAssets();
            renderStocksGrid();
        }

        function renderTeacherLeaderboard() {
            const body = document.getElementById('leaderboardBody');
            body.innerHTML = '';

            const rankingData = USER_PRESETS.filter(u => u.role === 'student').map(u => {
                const pf = studentPortfolios[u.id];
                let stockVal = 0;
                let holdingsText = [];

                Object.keys(stocks).forEach(gKey => {
                    const cnt = pf.shares[gKey] || 0;
                    if (cnt > 0) {
                        stockVal += cnt * stocks[gKey].price;
                        holdingsText.push(`${stocks[gKey].name}: ${cnt}股`);
                    }
                });

                const total = pf.cash + stockVal;
                return {
                    user: u,
                    cash: pf.cash,
                    stockVal: stockVal,
                    netWorth: total,
                    holdings: holdingsText.join(' | ') || '無任何持股'
                };
            });

            // Sort descending by Net Worth
            rankingData.sort((a, b) => b.netWorth - a.netWorth);

            rankingData.forEach((item, index) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-slate-800/40 transition';
                
                let badgeColor = 'bg-slate-800 text-slate-300';
                if (index === 0) badgeColor = 'bg-amber-500/20 text-amber-300 border border-amber-500/40';
                else if (index === 1) badgeColor = 'bg-slate-300/20 text-slate-200 border border-slate-300/40';
                else if (index === 2) badgeColor = 'bg-amber-700/20 text-amber-400 border border-amber-700/40';

                tr.innerHTML = `
                    <td class="py-3 px-3">
                        <span class="px-2 py-0.5 rounded-full font-bold text-[11px] ${badgeColor}">${index + 1}</span>
                    </td>
                    <td class="py-3 px-3 font-bold text-slate-100">${item.user.name}</td>
                    <td class="py-3 px-3 text-slate-400">${stocks[item.user.homeGroup].name}</td>
                    <td class="py-3 px-3 text-right font-semibold text-emerald-400">$${item.cash.toLocaleString()}</td>
                    <td class="py-3 px-3 text-right font-semibold text-indigo-400">$${item.stockVal.toLocaleString()}</td>
                    <td class="py-3 px-3 text-right font-extrabold text-amber-300">$${item.netWorth.toLocaleString()}</td>
                    <td class="py-3 px-3 text-slate-400 text-[11px]">${item.holdings}</td>
                `;
                body.appendChild(tr);
            });
        }

