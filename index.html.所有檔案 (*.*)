<!DOCTYPE html>
<html lang="zh-TW">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>班級股市模擬器 - 智慧資產重組系統</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #0b0f19;
            color: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: rgba(15, 23, 42, 0.6);
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(51, 65, 85, 0.8);
            border-radius: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(71, 85, 105, 1);
        }
        .glass-panel {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }
        .glass-card {
            background: rgba(30, 41, 59, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.05);
            transition: all 0.2s ease-in-out;
        }
        .glass-card:hover {
            border-color: rgba(99, 102, 241, 0.3);
            transform: translateY(-2px);
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between custom-scrollbar bg-slate-950 text-slate-100">

    <header class="sticky top-0 z-30 glass-panel border-b border-slate-800 px-4 py-3 shadow-xl">
        <div class="max-w-7xl mx-auto flex flex-wrap justify-between items-center gap-3">
            <div class="flex items-center gap-3">
                <div class="p-2.5 bg-indigo-600/20 text-indigo-400 border border-indigo-500/30 rounded-xl flex items-center justify-center">
                    <i class="fa-solid font-bold fa-chart-line text-xl"></i>
                </div>
                <div>
                    <h1 class="text-lg font-bold bg-gradient-to-r from-indigo-400 via-purple-300 to-pink-400 bg-clip-text text-transparent">
                        班級股市模擬器
                    </h1>
                    <p class="text-xs text-slate-400">資產重組與個股投資體驗 (基準每股 $100)</p>
                </div>
            </div>

            <!-- Header Action Controls -->
            <div class="flex items-center flex-wrap gap-2 text-xs">
                <!-- User Profile Badge -->
                <div id="userBadge" class="flex items-center gap-2 px-3 py-1.5 bg-slate-800/80 border border-slate-700 rounded-xl">
                    <span id="userAvatar" class="w-6 h-6 rounded-full bg-indigo-500/30 text-indigo-300 flex items-center justify-center font-bold text-[11px]">
                        ?
                    </span>
                    <span id="userName" class="font-semibold text-slate-200">未登入</span>
                </div>

                <!-- Teacher-Only Controls -->
                <div id="teacherControls" class="hidden flex items-center gap-2">
                    <button id="marketToggleBtn" onclick="toggleMarketStatus()" class="px-3 py-1.5 bg-emerald-600/80 hover:bg-emerald-500 text-white rounded-xl font-medium shadow-md transition flex items-center gap-1.5">
                        <i class="fa-solid fa-lock-open text-emerald-200"></i> <span id="marketStatusText">🟢 股市交易：開盤中</span>
                    </button>
                    <button onclick="openAdjustModal()" class="px-3 py-1.5 bg-amber-600/80 hover:bg-amber-500 text-white rounded-xl font-medium shadow-md transition flex items-center gap-1.5">
                        <i class="fa-solid fa-bolt text-amber-200"></i> ⚡ 課堂表現加減分
                    </button>
                    <button onclick="openPasswordModal()" class="px-3 py-1.5 bg-purple-600/80 hover:bg-purple-500 text-white rounded-xl font-medium shadow-md transition flex items-center gap-1.5">
                        <i class="fa-solid fa-key text-purple-200"></i> 🔑 密碼管理
                    </button>
                    <button onclick="triggerAIMarketNews()" class="px-3 py-1.5 bg-pink-600/80 hover:bg-pink-500 text-white rounded-xl font-medium shadow-md transition flex items-center gap-1.5">
                        <i class="fa-solid fa-robot text-pink-200"></i> 🤖 AI市場快訊
                    </button>
                </div>

                <!-- History Log Button -->
                <button onclick="openHistoryModal()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 border border-slate-700 rounded-xl font-medium transition flex items-center gap-1.5">
                    <i class="fa-solid fa-clock-rotate-left text-slate-400"></i> 📜 歷史紀錄
                </button>

                <!-- Switch Account / Logout Button -->
                <button onclick="openLoginModal()" class="px-3 py-1.5 bg-indigo-600/80 hover:bg-indigo-500 text-white rounded-xl font-medium shadow-md transition flex items-center gap-1.5">
                    <i class="fa-solid fa-right-from-bracket"></i> 切換帳號
                </button>
            </div>
        </div>
    </header>

    <main class="max-w-7xl mx-auto w-full px-4 py-6 flex-1 space-y-6">
        
        <!-- Rules Banner -->
        <section class="glass-panel p-4 rounded-2xl border border-indigo-500/20 shadow-lg">
            <h2 class="text-xs font-bold text-indigo-400 tracking-wider uppercase mb-2 flex items-center gap-1.5">
                <i class="fa-solid fa-circle-info"></i> 班級股市個人交易與資產重組規則
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 text-xs">
                <div class="p-2.5 bg-slate-900/60 rounded-xl border border-slate-800">
                    <span class="font-bold text-slate-200 block mb-0.5">1. 起始資產與現金</span>
                    <p class="text-slate-400">每位同學初始持有自家公司股票 <strong class="text-emerald-400">15 股</strong> (每股 $100) 及 <strong class="text-amber-400">$100 現金</strong>。</p>
                </div>
                <div class="p-2.5 bg-slate-900/60 rounded-xl border border-slate-800">
                    <span class="font-bold text-slate-200 block mb-0.5">2. 自家經營權保障</span>
                    <p class="text-slate-400">自家公司股票為經營核心，<strong class="text-rose-400">最少需保留 12 股</strong> (個人最多可賣出 3 股變現)。</p>
                </div>
                <div class="p-2.5 bg-slate-900/60 rounded-xl border border-slate-800">
                    <span class="font-bold text-slate-200 block mb-0.5">3. 自由資產重組</span>
                    <p class="text-slate-400">運用賣出自家股票所得現金，自由買進全班其他 4 組股票，進行分散風險與投資配置。</p>
                </div>
            </div>
        </section>

        <div id="studentDashboard" class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            
            <!-- Left Side: Student Personal Asset Card -->
            <div class="lg:col-span-4 space-y-4">
                <div class="glass-panel p-5 rounded-2xl border border-slate-800 shadow-xl space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                        <h3 class="font-bold text-slate-200 flex items-center gap-2 text-sm">
                            <i class="fa-solid fa-wallet text-indigo-400"></i> 個人資產總額統計
                        </h3>
                        <button onclick="triggerAIPortfolioAdvisor()" class="text-xs px-2.5 py-1 bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white rounded-lg font-medium shadow transition flex items-center gap-1">
                            <i class="fa-solid fa-wand-magic-sparkles"></i> AI 理財診斷
                        </button>
                    </div>

                    <!-- Total Net Worth Highlight -->
                    <div class="p-4 bg-slate-900/80 rounded-xl border border-slate-800 text-center space-y-1">
                        <span class="text-[11px] font-semibold text-slate-400 uppercase tracking-wider">目前總資產淨值 (Net Worth)</span>
                        <div id="netWorthDisplay" class="text-3xl font-extrabold text-amber-300">
                            $1,600 <span class="text-sm font-normal text-slate-400">班幣</span>
                        </div>
                        <div class="grid grid-cols-2 gap-2 pt-2 text-xs border-t border-slate-800/80">
                            <div>
                                <span class="text-slate-400 block text-[10px]">現金:</span>
                                <span id="cashDisplay" class="font-bold text-emerald-400">$100</span>
                            </div>
                            <div>
                                <span class="text-slate-400 block text-[10px]">股票市值:</span>
                                <span id="stockValueDisplay" class="font-bold text-indigo-400">$1,500</span>
                            </div>
                        </div>
                    </div>

                    <!-- Asset Donut Chart -->
                    <div class="relative h-48 w-full flex items-center justify-center">
                        <canvas id="assetChart"></canvas>
                    </div>

                    <!-- Holdings List Breakdown -->
                    <div class="space-y-2">
                        <div class="flex justify-between items-center text-xs text-slate-400 font-semibold px-1">
                            <span>持股明細</span>
                            <span id="homeStockRuleTag" class="text-[10px] px-2 py-0.5 bg-amber-500/10 text-amber-300 border border-amber-500/20 rounded-full">
                                自家保留 15 股 (下限 12 股)
                            </span>
                        </div>
                        <div id="holdingsList" class="space-y-1.5 text-xs max-h-48 overflow-y-auto custom-scrollbar pr-1">
                            <!-- Holdings populated dynamically -->
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Student Trading Order Center -->
            <div class="lg:col-span-8 space-y-4">
                <div class="glass-panel p-5 rounded-2xl border border-slate-800 shadow-xl space-y-4">
                    <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                        <div>
                            <h3 class="font-bold text-slate-200 flex items-center gap-2 text-sm">
                                <i class="fa-solid fa-arrow-right-arrow-left text-emerald-400"></i> 股票買賣下單中心
                            </h3>
                            <p class="text-[11px] text-slate-400">點擊股票卡片可進行買進或賣出，並隨時查看個股 AI 研報</p>
                        </div>
                        <div class="text-xs bg-slate-800/80 px-3 py-1 rounded-lg border border-slate-700 text-slate-300">
                            各組每股均價: <span class="text-amber-300 font-bold">$100 起</span>
                        </div>
                    </div>

                    <!-- Stocks Grid -->
                    <div id="stocksGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <!-- Rendered dynamically -->
                    </div>
                </div>
            </div>
        </div>

        <div id="teacherDashboard" class="hidden space-y-4">
            <div class="glass-panel p-6 rounded-2xl border border-purple-500/20 shadow-2xl space-y-5">
                <div class="flex flex-wrap justify-between items-center gap-3 border-b border-slate-800 pb-4">
                    <div>
                        <h3 class="text-base font-bold text-purple-300 flex items-center gap-2">
                            <i class="fa-solid fa-trophy text-amber-400"></i> 全班學生總資產排行榜與數據統計看板
                        </h3>
                        <p class="text-xs text-slate-400">即時監控 23 位學生現金、持股與總資產狀況 (僅班導師可見)</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="text-xs text-slate-400">即時更新中</span>
                        <button onclick="renderTeacherLeaderboard()" class="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-medium border border-slate-700 transition">
                            <i class="fa-solid fa-rotate-right"></i> 刷新數據
                        </button>
                    </div>
                </div>

                <!-- Class Leaderboard Table -->
                <div class="overflow-x-auto custom-scrollbar">
                    <table class="w-full text-left border-collapse text-xs">
                        <thead>
                            <tr class="border-b border-slate-800 text-slate-400 uppercase font-semibold text-[11px]">
                                <th class="py-3 px-3">名次</th>
                                <th class="py-3 px-3">學生姓名/座號</th>
                                <th class="py-3 px-3">所屬公司</th>
                                <th class="py-3 px-3 text-right">現金餘額</th>
                                <th class="py-3 px-3 text-right">股票市值</th>
                                <th class="py-3 px-3 text-right">總資產淨值</th>
                                <th class="py-3 px-3">持股細節與配置</th>
                            </tr>
                        </thead>
                        <tbody id="leaderboardBody" class="divide-y divide-slate-800/60 font-medium">
                            <!-- Leaderboard populated dynamically -->
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </main>

    <!-- Notification Toast Modal (Replaces browser alert) -->
    <div id="noticeModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel max-w-sm w-full p-5 rounded-2xl border border-amber-500/30 shadow-2xl space-y-4 text-center">
            <div id="noticeIcon" class="w-12 h-12 mx-auto rounded-2xl flex items-center justify-center text-xl bg-amber-500/20 text-amber-400 border border-amber-500/30">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>
            <div class="space-y-1">
                <h4 id="noticeTitle" class="font-bold text-slate-100 text-sm">交易提示</h4>
                <p id="noticeMessage" class="text-xs text-slate-300 leading-relaxed">提示訊息內容</p>
            </div>
            <button onclick="closeModal('noticeModal')" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-bold border border-slate-700 transition">
                確定瞭解
            </button>
        </div>
    </div>

    <!-- Modal 1: Login Modal -->
    <div id="loginModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel max-w-md w-full p-6 rounded-2xl border border-slate-800 shadow-2xl space-y-5">
            <div class="text-center space-y-2">
                <div class="w-12 h-12 mx-auto bg-indigo-600/20 text-indigo-400 rounded-2xl flex items-center justify-center border border-indigo-500/30">
                    <i class="fa-solid fa-user-lock text-2xl"></i>
                </div>
                <h3 class="text-lg font-bold text-slate-100">學生與班導師登入</h3>
                <p class="text-xs text-slate-400">請選擇個人座號或導師身分，並輸入密碼驗證</p>
            </div>

            <div class="space-y-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">1. 選擇身份 / 座號</label>
                    <select id="loginUserSelect" class="w-full px-3 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-xs focus:ring-2 focus:ring-indigo-500 outline-none">
                        <!-- Populated dynamically -->
                    </select>
                </div>

                <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1">2. 輸入密碼</label>
                    <div class="relative">
                        <input type="password" id="loginPasswordInput" placeholder="請輸入個人密碼" class="w-full px-3 py-2.5 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-xs focus:ring-2 focus:ring-indigo-500 outline-none pr-10">
                        <button type="button" onclick="togglePasswordVisibility('loginPasswordInput', 'pwdToggleIcon')" class="absolute right-3 top-2.5 text-slate-400 hover:text-slate-200 text-xs">
                            <i id="pwdToggleIcon" class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div id="loginErrorMsg" class="hidden p-2.5 bg-rose-950/60 border border-rose-800/80 rounded-xl text-rose-300 text-xs text-center font-medium">
                    密碼錯誤，請重新輸入！
                </div>

                <button onclick="handleLogin()" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-500 text-white rounded-xl text-xs font-bold shadow-lg shadow-indigo-600/30 transition">
                    安全登入系統
                </button>
            </div>
        </div>
    </div>

    <!-- Modal 2: Teacher Adjust Modal -->
    <div id="adjustModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel max-w-lg w-full p-6 rounded-2xl border border-slate-800 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-amber-300 flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-bolt"></i> ⚡ 課堂表現與事件加減分控制台
                </h3>
                <button onclick="closeModal('adjustModal')" class="text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="space-y-4 text-xs">
                <div>
                    <label class="block font-bold text-slate-300 mb-1">1. 選擇影響的組別公司</label>
                    <select id="adjustStockSelect" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-xs outline-none">
                        <option value="group1">一組科技</option>
                        <option value="group2">二組餐飲</option>
                        <option value="group3">三組娛樂</option>
                        <option value="group4">四組金融</option>
                        <option value="group5">五組百貨</option>
                    </select>
                </div>

                <div>
                    <label class="block font-bold text-slate-300 mb-1">2. 快速選擇課堂事件項目 (數值均 $\ge 10$ 元)</label>
                    <div id="presetContainer" class="grid grid-cols-2 gap-2 max-h-52 overflow-y-auto custom-scrollbar pr-1">
                        <!-- Preset buttons dynamically injected -->
                    </div>
                </div>

                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block font-bold text-slate-300 mb-1">自訂股價增減金額 ($)</label>
                        <input type="number" id="adjustDeltaInput" placeholder="例如: -10 或 15" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-xs outline-none">
                    </div>
                    <div>
                        <label class="block font-bold text-slate-300 mb-1">事件或扣分事由說明</label>
                        <input type="text" id="adjustReasonInput" placeholder="例如：課堂秩序混亂扣分" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-xs outline-none">
                    </div>
                </div>

                <div class="flex gap-2 pt-2">
                    <button onclick="applyStockAdjustment()" class="flex-1 py-2.5 bg-amber-600 hover:bg-amber-500 text-white rounded-xl font-bold shadow-lg transition">
                        確認發布加減分事件
                    </button>
                    <button onclick="closeModal('adjustModal')" class="py-2.5 px-4 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl font-medium transition">
                        取消
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal 3: Password Management Modal -->
    <div id="passwordModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel max-w-md w-full p-6 rounded-2xl border border-slate-800 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-purple-300 flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-key"></i> 🔑 密碼管理中心 (導師專用)
                </h3>
                <button onclick="closeModal('passwordModal')" class="text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="space-y-4 text-xs">
                <div>
                    <label class="block font-semibold text-slate-300 mb-1">選擇要修改密碼的帳號</label>
                    <select id="pwdUserSelect" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-xs">
                        <!-- Populated dynamically -->
                    </select>
                </div>

                <div>
                    <label class="block font-semibold text-slate-300 mb-1">輸入新密碼</label>
                    <input type="text" id="newPasswordInput" placeholder="輸入新密碼" class="w-full px-3 py-2 bg-slate-900 border border-slate-700 rounded-xl text-slate-200 text-xs">
                </div>

                <button onclick="saveUserPassword()" class="w-full py-2.5 bg-purple-600 hover:bg-purple-500 text-white rounded-xl font-bold shadow-lg transition">
                    儲存新密碼設定
                </button>
            </div>
        </div>
    </div>

    <!-- Modal 4: History Log Modal -->
    <div id="historyModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-md z-50 flex items-center justify-center p-4 hidden">
        <div class="glass-panel max-w-2xl w-full p-6 rounded-2xl border border-slate-800 shadow-2xl space-y-4">
            <div class="flex justify-between items-center border-b border-slate-800 pb-3">
                <h3 class="font-bold text-slate-200 flex items-center gap-2 text-sm">
                    <i class="fa-solid fa-clock-rotate-left text-indigo-400"></i> 📜 班級事件與加減分歷史紀錄
                </h3>
                <button onclick="closeModal('historyModal')" class="text-slate-400 hover:text-slate-200">
                    <i class="fa-solid fa-xmark text-base"></i>
                </button>
            </div>

            <div class="max-h-80 overflow-y-auto custom-scrollbar pr-1">
                <table class="w-full text-left text-xs border-collapse">
                    <thead>
                        <tr class="border-b border-slate-800 text-slate-400 font-semibold">
                            <th class="py-2.5 px-2">發布時間</th>
                            <th class="py-2.5 px-2">受影響公司</th>
                            <th class="py-2.5 px-2">事件與事由項目</th>
                            <th class="py-2.5 px-2 text-right">金額變動</th>
                            <th class="py-2.5 px-2 text-right">調整後最新股價</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody" class="divide-y divide-slate-800/60 font-medium">
                        <!-- Populated dynamically -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal 5: AI Modal -->
