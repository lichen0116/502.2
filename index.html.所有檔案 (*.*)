        function applyStockAdjustment() {
            const gKey = document.getElementById('adjustStockSelect').value;
            const delta = parseFloat(document.getElementById('adjustDeltaInput').value);
            const reason = document.getElementById('adjustReasonInput').value.trim() || '課堂表現調整';

            if (isNaN(delta)) {
                showNotice('請輸入數值', '請在增減金額欄位填寫有效的數字（例如 15 或 -10）！', 'fa-circle-exclamation');
                return;
            }

            stocks[gKey].price = Math.max(10, stocks[gKey].price + delta);

            historyLogs.unshift({
                time: new Date().toLocaleTimeString(),
                stockName: stocks[gKey].name,
                reason: reason,
                delta: delta,
                newPrice: stocks[gKey].price
            });

            closeModal('adjustModal');
            document.getElementById('adjustDeltaInput').value = '';
            document.getElementById('adjustReasonInput').value = '';

            renderMainLayout();
            showNotice('股價變更成功', `已更新【${stocks[gKey].name}】股價！變動金額: ${delta >= 0 ? '+' : ''}$${delta}，最新股價為 $${stocks[gKey].price}`, 'fa-circle-check', 'text-emerald-400', 'border-emerald-500/30');
        }

        function openPasswordModal() {
            if (!currentUser || currentUser.role !== 'teacher') return;
            document.getElementById('passwordModal').classList.remove('hidden');
        }

        function saveUserPassword() {
            const targetId = document.getElementById('pwdUserSelect').value;
            const newPwd = document.getElementById('newPasswordInput').value.trim();

            if (!newPwd) {
                showNotice('輸入無效', '新密碼不可為空！', 'fa-circle-exclamation');
                return;
            }

            const target = USER_PRESETS.find(u => u.id === targetId);
            if (target) {
                target.password = newPwd;
                closeModal('passwordModal');
                document.getElementById('newPasswordInput').value = '';
                showNotice('密碼更新完成', `已成功將【${target.name}】的密碼設定為：${newPwd}`, 'fa-key', 'text-purple-400', 'border-purple-500/30');
            }
        }

        function openHistoryModal() {
            const body = document.getElementById('historyTableBody');
            body.innerHTML = '';

            if (historyLogs.length === 0) {
                body.innerHTML = `<tr><td colspan="5" class="py-6 text-center text-slate-500">尚無歷史加減分或市場事件紀錄</td></tr>`;
            } else {
                historyLogs.forEach(log => {
                    const tr = document.createElement('tr');
                    tr.className = 'hover:bg-slate-800/40 transition';
                    const isPositive = log.delta >= 0;
                    tr.innerHTML = `
                        <td class="py-2.5 px-2 text-slate-400">${log.time}</td>
                        <td class="py-2.5 px-2 font-bold text-slate-200">${log.stockName}</td>
                        <td class="py-2.5 px-2 text-slate-300">${log.reason}</td>
                        <td class="py-2.5 px-2 text-right font-bold ${isPositive ? 'text-emerald-400' : 'text-rose-400'}">
                            ${isPositive ? '+' : ''}$${log.delta}
                        </td>
                        <td class="py-2.5 px-2 text-right font-extrabold text-amber-300">$${log.newPrice}</td>
                    `;
                    body.appendChild(tr);
                });
            }

            document.getElementById('historyModal').classList.remove('hidden');
        }

        async function callGeminiText(prompt, systemInstruction = "") {
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;
            const payload = {
                contents: [{ parts: [{ text: prompt }] }],
                systemInstruction: systemInstruction ? { parts: [{ text: systemInstruction }] } : undefined
            };

            const resp = await fetch(apiUrl, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            });
            const result = await resp.json();
            return result.candidates?.[0]?.content?.parts?.[0]?.text || "AI 暫時無法回應，請稍後再試。";
        }

        async function triggerAIPortfolioAdvisor() {
